	cd /home/chenzhao/ssh-projects/eloqstore_standby_local/bld && $(MAKE) $(MAKESILENT) -f db_stress/CMakeFiles/test_client.dir/build.make db_stress/CMakeFiles/test_client.dir/test_client.cpp.s
.PHONY : test_client.cpp.s

