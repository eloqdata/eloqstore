store_path_lut.cpp.o:
	cd /home/chenzhao/ssh-projects/eloqstore_standby_local/bld && $(MAKE) $(MAKESILENT) -f tests/CMakeFiles/store_path_lut.dir/build.make tests/CMakeFiles/store_path_lut.dir/store_path_lut.cpp.o
